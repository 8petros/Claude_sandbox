    {
      "id": "n9",
      "name": "Normalize Google Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        -320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst output = [];\n\nitems.forEach((item, idx) => {\n  const meta = $('Build Query Matrix').itemMatching(idx).json;\n  const results = item.json.items || [];\n  for (const r of results) {\n    output.push({\n      json: {\n        engine: 'google',\n        keywordGroup: meta.keywordGroup,\n        query: meta.query,\n        title: r.title || '',\n        link: r.link || '',\n        snippet: r.snippet || '',\n      },\n    });\n  }\n});\n\nreturn output;\n"
      }
    },
    {
      "id": "n10",
      "name": "Normalize Bing Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        -100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst output = [];\n\nitems.forEach((item, idx) => {\n  const meta = $('Build Query Matrix').itemMatching(idx).json;\n  const results = (item.json.webPages && item.json.webPages.value) || [];\n  for (const r of results) {\n    output.push({\n      json: {\n        engine: 'bing',\n        keywordGroup: meta.keywordGroup,\n        query: meta.query,\n        title: r.name || '',\n        link: r.url || '',\n        snippet: r.snippet || '',\n      },\n    });\n  }\n});\n\nreturn output;\n"
      }
    },
    {
      "id": "n11",
      "name": "Normalize Brave Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        120
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst output = [];\n\nitems.forEach((item, idx) => {\n  const meta = $('Build Query Matrix').itemMatching(idx).json;\n  const results = (item.json.web && item.json.web.results) || [];\n  for (const r of results) {\n    output.push({\n      json: {\n        engine: 'brave',\n        keywordGroup: meta.keywordGroup,\n        query: meta.query,\n        title: r.title || '',\n        link: r.url || '',\n        snippet: r.description || '',\n      },\n    });\n  }\n});\n\nreturn output;\n"
      }
    },
    {
      "id": "n12",
      "name": "Extract DuckDuckGo Fields",
      "type": "n8n-nodes-base.htmlExtract",
      "typeVersion": 1.2,
      "position": [
        20,
        340
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "sourceData": "json",
        "dataPropertyName": "data",
        "extractionValues": {
          "values": [
            {
              "key": "title",
              "cssSelector": ".result__a",
              "returnArray": true
            },
            {
              "key": "link",
              "cssSelector": ".result__a",
              "returnValue": "attribute",
              "attribute": "href",
              "returnArray": true
            },
            {
              "key": "snippet",
              "cssSelector": ".result__snippet",
              "returnArray": true
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n13",
      "name": "Normalize DuckDuckGo Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        340
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// The \"Extract DuckDuckGo Fields\" node returns one item per query, each\n// holding parallel arrays (title[], link[], snippet[]) pulled from the\n// result HTML. This node zips them into one flat result per hit and\n// resolves DuckDuckGo's redirect links (/l/?uddg=<encoded-url>) back to\n// the real target URL.\nconst items = $input.all();\nconst output = [];\n\nitems.forEach((item, idx) => {\n  const meta = $('Build Query Matrix').itemMatching(idx).json;\n  const titles = item.json.title || [];\n  const links = item.json.link || [];\n  const snippets = item.json.snippet || [];\n  const count = Math.max(titles.length, links.length);\n\n  for (let i = 0; i < count; i++) {\n    const rawLink = links[i] || '';\n    let link = rawLink;\n    try {\n      const u = new URL(rawLink, 'https://duckduckgo.com');\n      const uddg = u.searchParams.get('uddg');\n      if (uddg) link = decodeURIComponent(uddg);\n    } catch (e) {\n      // keep rawLink as-is if it doesn't parse\n    }\n    output.push({\n      json: {\n        engine: 'duckduckgo',\n        keywordGroup: meta.keywordGroup,\n        query: meta.query,\n        title: (titles[i] || '').trim(),\n        link,\n        snippet: (snippets[i] || '').trim(),\n      },\n    });\n  }\n});\n\nreturn output;\n"
      }
    },
    {
      "id": "n14",
      "name": "Merge All Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.1,
      "position": [
        500,
        0
      ],
      "parameters": {
        "mode": "append",
        "numberInputs": 4

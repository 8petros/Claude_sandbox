    {
      "id": "n15",
      "name": "Timestamp Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const now = new Date();\nconst pad = (n) => String(n).padStart(2, '0');\nconst date = `${now.getUTCFullYear()}-${pad(now.getUTCMonth() + 1)}-${pad(now.getUTCDate())}`;\nconst time = `${pad(now.getUTCHours())}:${pad(now.getUTCMinutes())}:${pad(now.getUTCSeconds())} UTC`;\n\nreturn $input.all().map((item) => ({\n  json: {\n    ...item.json,\n    date,\n    time,\n  },\n}));\n"
      }
    },
    {
      "id": "n16",
      "name": "Dedupe & Append To File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Reads the markdown log (if it exists), drops any result whose URL is\n// already logged, appends the genuinely new ones, and writes the file\n// back. Requires the n8n process to allow the 'fs' and 'path' built-ins\n// (NODE_FUNCTION_ALLOW_BUILTIN=fs,path) since this runs in the Code node.\nconst fs = require('fs');\nconst path = require('path');\n\nconst outputFile = $('Search Configuration').first().json.outputFile;\n\nfs.mkdirSync(path.dirname(outputFile), { recursive: true });\n\nlet existingContent = '';\nif (fs.existsSync(outputFile)) {\n  existingContent = fs.readFileSync(outputFile, 'utf8');\n}\n\nfunction normalizeUrl(u) {\n  try {\n    const url = new URL(u);\n    url.hash = '';\n    [...url.searchParams.keys()]\n      .filter((k) => k.toLowerCase().startsWith('utm_'))\n      .forEach((k) => url.searchParams.delete(k));\n    let s = url.toString();\n    if (s.endsWith('/')) s = s.slice(0, -1);\n    return s.toLowerCase();\n  } catch (e) {\n    return (u || '').trim().toLowerCase();\n  }\n}\n\nconst seen = new Set();\nconst linkLineRegex = /-\\s*\\*\\*Link:\\*\\*\\s*\\[[^\\]]*\\]\\(([^)]+)\\)/g;\nlet m;\nwhile ((m = linkLineRegex.exec(existingContent)) !== null) {\n  seen.add(normalizeUrl(m[1]));\n}\n\nconst newEntries = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  if (!r.link) continue;\n  const key = normalizeUrl(r.link);\n  if (seen.has(key)) continue;\n  seen.add(key);\n  newEntries.push(r);\n}\n\nfunction escapeMd(text) {\n  return (text || '').replace(/\\r?\\n/g, ' ').trim();\n}\n\nconst blocks = newEntries.map((r) => {\n  const title = escapeMd(r.title) || r.link;\n  return [\n    `### ${title}`,\n    `- **Date:** ${r.date}`,\n    `- **Time:** ${r.time}`,\n    `- **Matched keywords:** ${r.keywordGroup}`,\n    `- **Search engine:** ${r.engine}`,\n    `- **Link:** [${title}](${r.link})`,\n    `- **Lead:** ${escapeMd(r.snippet) || '_no summary available_'}`,\n    '',\n    '---',\n    '',\n  ].join('\\n') + '\\n';\n});\n\nif (blocks.length) {\n  const header = existingContent.trim().length === 0 ? '# Web Search Log\\n\\n' : '';\n  fs.appendFileSync(outputFile, header + blocks.join(''));\n}\n\nreturn [\n  {\n    json: {\n      newResultsCount: newEntries.length,\n      totalFetched: $input.all().length,\n      outputFile,\n    },\n  },\n];\n"
      }
    },

    {
      "id": "n3",
      "name": "Build Query Matrix",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -680,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cfg = $input.first().json;\n\nconst keywordGroups = typeof cfg.keywordGroups === 'string'\n  ? JSON.parse(cfg.keywordGroups)\n  : cfg.keywordGroups;\n\nconst engines = (typeof cfg.engines === 'string' ? cfg.engines.split(',') : cfg.engines)\n  .map((e) => e.trim().toLowerCase())\n  .filter(Boolean);\n\nfunction quote(term) {\n  return term.includes(' ') ? `\"${term}\"` : term;\n}\n\n// Builds a query string using the operators most search engines share:\n// space = AND, (a OR b) = OR, -term = NOT.\nfunction buildQuery(group) {\n  const all = (group.all || []).map(quote).join(' ');\n  const any = (group.any || []).map(quote);\n  const anyPart = any.length ? `(${any.join(' OR ')})` : '';\n  const none = (group.none || []).map((t) => `-${quote(t)}`).join(' ');\n  return [all, anyPart, none].filter(Boolean).join(' ').trim();\n}\n\nconst items = [];\nfor (const group of keywordGroups) {\n  const query = buildQuery(group);\n  for (const engine of engines) {\n    items.push({\n      json: {\n        engine,\n        keywordGroup: group.name,\n        query,\n        resultsPerQuery: cfg.resultsPerQuery || 10,\n      },\n    });\n  }\n}\n\nreturn items;\n"
      }
    },

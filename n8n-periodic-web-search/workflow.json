              "value": "[{\"name\": \"AI Regulation EU\", \"all\": [\"artificial intelligence\", \"regulation\"], \"any\": [\"EU\", \"European Union\", \"Brussels\"], \"none\": [\"cryptocurrency\"]}, {\"name\": \"Quantum Computing Breakthroughs\", \"all\": [\"quantum computing\"], \"any\": [\"breakthrough\", \"milestone\", \"record\"], \"none\": []}]"
